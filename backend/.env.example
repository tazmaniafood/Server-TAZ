# Copiar como .env y poner los valores reales (NO subir .env a GitHub)
#   cp .env.example .env

# --- Servidor ---
PORT=3000

# --- PostgreSQL (usuario taz_app, permisos mínimos) ---
DATABASE_URL=postgresql://taz_app:CAMBIA_ESTA_CLAVE@localhost:5432/tazmania_db

# --- Pool de conexiones ---
DB_POOL_MAX=20            # conexiones abiertas como máximo
DB_POOL_IDLE_MS=30000     # cierra una conexión si lleva 30 s sin usarse
DB_POOL_TIMEOUT_MS=5000   # error si en 5 s no hay conexión libre
