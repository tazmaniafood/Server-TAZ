# Copiar como .env y poner los valores reales (NO subir .env a GitHub)
#   cp .env.example .env

# --- Servidor ---
PORT=3000

# --- PostgreSQL (usuario taz_app, permisos mínimos) ---
DATABASE_URL=postgresql://taz_app:CAMBIA_ESTA_CLAVE@localhost:5432/tazmania_db

# --- Pool de conexiones ---
# conexiones abiertas como máximo
DB_POOL_MAX=20
# cierra una conexión si lleva 30 s sin usarse
DB_POOL_IDLE_MS=30000
# error si en 5 s no hay conexión libre
DB_POOL_TIMEOUT_MS=5000

# --- Restaurante (punto de salida del delivery) ---
# En Google Maps: clic derecho sobre el restaurante -> copiar las coordenadas
RESTAURANTE_LAT=
RESTAURANTE_LNG=

# --- Google Maps ---
# Clave del SERVIDOR: solo Routes API, restringida a la IP del servidor. SECRETA.
GOOGLE_MAPS_SERVER_KEY=
# Clave del NAVEGADOR: Maps JavaScript API + Places API (New), restringida a tu dominio.
# Es pública (la página la recibe por GET /api/config).
GOOGLE_MAPS_BROWSER_KEY=

# --- Stripe (dashboard.stripe.com -> Developers -> API keys) ---
# Usar las de prueba (sk_test_/pk_test_) hasta que todo funcione.
# sk_... (SECRETA)
STRIPE_SECRET_KEY=
# pk_... (pública)
STRIPE_PUBLISHABLE_KEY=
# Developers -> Webhooks -> endpoint https://tudominio.com/api/stripe/webhook
# eventos: payment_intent.succeeded, payment_intent.payment_failed
# whsec_... (SECRETA)
STRIPE_WEBHOOK_SECRET=
STRIPE_MONEDA=usd
